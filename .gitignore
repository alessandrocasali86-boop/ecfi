# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.dist-info/

# --- Environments ---
.venv/
venv/
.env/

# --- Build / packaging ---
build/
dist/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log

# --- Run outputs (keep the directory itself via outputs/.gitkeep) ---
outputs/*
!outputs/.gitkeep

# --- Audio ---
# MP3 renderings are tracked so the repository is audible out of the box.
# Lossless WAV masters stay out of git and are deposited on Zenodo (README §9).
*.wav

# --- Audio-TDA outputs: ignore every run directory except the curated one ---
audio_tda_out*/
!audio_tda_out_nowarn/
!audio_tda_out_nowarn/*.png
!audio_tda_out_nowarn/*.csv
!audio_tda_out_nowarn/config.json
!audio_tda_out_nowarn/run_config.json

# --- Duplicated figure sets, deliberately untracked ---
# docs/figures/audio_tda/ holds byte-identical copies of audio_tda_out_nowarn/*.png
# docs/figures/sim/ is a later re-render of the frozen baseline figures already
# tracked directly under docs/figures/. The tracked copies are canonical.
docs/figures/audio_tda/
docs/figures/sim/
